---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { externalGames } from "@/data/externalGames";
import { brandAccentClass } from "@/data/accentClasses";

const featuredGames = [
  {
    href: "/play/",
    title: "Amaze Game Online",
    shortTitle: "Amaze Game",
    category: "Main game",
    description: "Slide through maze grids, color every tile, and solve the full route.",
    thumbnail: "/amaze/categories/intermediate.svg",
    accentClass: brandAccentClass,
  },
  ...externalGames.slice(0, 3).map((game) => ({
    href: "/games/" + game.slug + "/",
    title: game.title,
    shortTitle: game.shortTitle,
    category: game.category,
    description: game.description,
    thumbnail: game.thumbnail,
    accentClass: game.accentClass,
  })),
];

const directoryGames = [
  {
    href: "/play/",
    title: "Amaze Game Online",
    shortTitle: "Amaze Game",
    category: "Maze fill puzzle",
    description: "The main Amaze Game experience with sliding movement, route planning, and a fill-every-tile goal.",
    thumbnail: "/amaze/categories/intermediate.svg",
    accentClass: brandAccentClass,
  },
  ...externalGames.map((game) => ({
    href: "/games/" + game.slug + "/",
    title: game.title,
    shortTitle: game.shortTitle,
    category: game.category,
    description: game.description,
    thumbnail: game.thumbnail,
    accentClass: game.accentClass,
  })),
];
---

<BaseLayout title="Amaze Game and Free Online Puzzle Games" description="Play Amaze Game and related free browser puzzle games for maze, route, grid, number, and tile logic fans.">
  <section class="games-directory">
    <header class="games-directory-hero">
      <div>
        <h1>Free browser puzzle games.</h1>
        <p>Play Amaze Game and a focused library of route, grid, tile, and logic games. No downloads, no account setup, just clean browser play.</p>
      </div>
      <a class="games-directory-action" href="/play/"><span></span>Play Amaze Game</a>
    </header>

    <div class="games-feature-rail" aria-label="Featured games">
      {featuredGames.map((game, index) => (
        <a class:list={["games-feature-link", game.accentClass]} href={game.href}>
          <img src={game.thumbnail} alt={game.title + " thumbnail"} width="640" height="360" loading="lazy" />
          <div>
            <span>{game.category}</span>
            <strong>{game.shortTitle}</strong>
          </div>
          <small>{index === 0 ? "Start here" : "Related pick"}</small>
        </a>
      ))}
    </div>

    <section class="games-directory-main" aria-labelledby="games-directory-title">
      <div class="games-directory-intro">
        <h2 id="games-directory-title">Choose a game</h2>
        <p>{directoryGames.length} browser games selected for Amaze Game players and low-friction puzzle sessions.</p>
      </div>

      <div class="games-directory-list">
        {directoryGames.map((game, index) => (
          <a class:list={["games-directory-row", game.accentClass]} href={game.href}>
            <span class="games-directory-number">{String(index + 1).padStart(2, "0")}</span>
            <img src={game.thumbnail} alt={game.title + " thumbnail"} width="320" height="180" loading="lazy" />
            <div>
              <span>{game.category}</span>
              <h3>{game.title}</h3>
              <p>{game.description}</p>
            </div>
            <span class="games-directory-arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                <path d="M7 17L17 7M9 7h8v8" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="games-guide-strip" aria-labelledby="games-library-guide">
      <h3 id="games-library-guide">Game library guide</h3>
      <div>
        <article>
          <h3>Free browser games in one place</h3>
          <p>The games library keeps Amaze Game at the center while offering related puzzles that share its route planning, grid reading, and low-friction browser play.</p>
        </article>
        <article>
          <h3>How to choose a game</h3>
          <p>Choose Amaze Game for maze filling, Brain Line Connect for one-line paths, Block Puzzle for shape placement, Mahjong Connect for path-based matching, and Sudoku for pure deduction.</p>
        </article>
        <article>
          <h3>Why no-download play matters</h3>
          <p>Browser puzzle games are useful because you can open a page, play immediately, and leave without installing software or creating an account.</p>
        </article>
      </div>
    </section>
  </section>
</BaseLayout>
