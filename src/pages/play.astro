---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AdsterraBanner from "@/components/AdsterraBanner.astro";
import { externalGames } from "@/data/externalGames";
import { siteConfig } from "@/data/siteConfig";

const playSteps = [
  ["1", "Scan", "Find corners, narrow corridors, and single-entry pockets."],
  ["2", "Slide", "Swipe or use arrow keys to move until the path stops."],
  ["3", "Fill", "Color every tile and restart when a route strands a square."],
];

const tips = [
  "Plan the finish before the first move on harder boards.",
  "Save true dead ends for last unless the layout says otherwise.",
  "Use failed routes as information instead of repeating the same opening.",
];

const relatedGames = externalGames.slice(0, 4);
---

<BaseLayout
  title={"Play " + siteConfig.name + " Online"}
  description="Play Amaze Game online free in your browser. Slide through maze grids, fill every tile, and solve route-planning puzzles with no download."
>
  <section class="play-stage" id="top">
    <div class="play-stage-bg" aria-hidden="true"></div>
    <aside class="play-ad-rail" aria-label="Sponsored advertisement"><AdsterraBanner format="skyscraper" /></aside>
    <div class="play-shell" data-game-shell>
      <iframe src="/game/index.html" title="Connect The Dot online puzzle" allow="autoplay; fullscreen *" allowfullscreen></iframe>
      <div class="play-float-controls">
        <button type="button" data-share-game aria-label="Share Amaze Game">
          <span>Share</span>
        </button>
        <button type="button" data-fullscreen-game aria-label="Fullscreen Amaze Game">
          <span>Fullscreen</span>
        </button>
      </div>
    </div>
  </section>

  <div class="play-ad-leaderboard"><AdsterraBanner /></div>

  <section class="play-info-section">
    <div class="play-info-head">
      <p class="eyebrow">Play online</p>
      <h1>Amaze Game in your browser.</h1>
      <p>Free, instant, and built for satisfying maze-fill puzzle sessions.</p>
    </div>
    <div class="play-step-grid">
      {playSteps.map(([number, title, text]) => (
        <article>
          <span>{number}</span>
          <strong>{title}</strong>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="play-info-section play-split-section">
    <div>
      <p class="eyebrow">Related games</p>
      <p class="play-panel-title">More route and grid puzzles.</p>
      <div class="play-category-pills">
        {relatedGames.map((game) => <a href={"/games/" + game.slug + "/"}>{game.shortTitle}</a>)}
      </div>
    </div>
    <div class="play-tip-panel">
      <p class="eyebrow">Tips</p>
      <ul>
        {tips.map((tip) => <li>{tip}</li>)}
      </ul>
    </div>
  </section>

  <section class="play-info-section seo-copy-section" aria-labelledby="play-page-guide">
    <div class="section-head">
      <h2 id="play-page-guide">Amaze Game play guide.</h2>
    </div>
    <div class="seo-copy-grid">
      <article class="seo-copy-card seo-copy-wide">
        <h3>What makes Amaze Game different</h3>
        <p>Amaze Game is a maze-fill puzzle where the win condition is exact: every tile must be colored. The simple control hides a deeper route problem because each slide travels in a straight line until it stops. That makes planning more important than speed.</p>
      </article>
      <article class="seo-copy-card">
        <h3>How to start a strong solve</h3>
        <p>Look for corners, narrow branches, and pockets with only one entry. Decide which area should be filled last, then choose an opening move that keeps the remaining board reachable.</p>
      </article>
      <article class="seo-copy-card">
        <h3>Best sessions</h3>
        <p>Play quick beginner routes during short breaks, then move into harder levels when you want deeper focus. The game runs in the browser with no account, so it works well on desktop, tablet, and mobile.</p>
      </article>
    </div>
  </section>
  <script is:inline>
    (() => {
      const shell = document.querySelector("[data-game-shell]");
      const iframe = shell?.querySelector("iframe");
      const fullscreen = document.querySelector("[data-fullscreen-game]");
      const share = document.querySelector("[data-share-game]");
      fullscreen?.addEventListener("click", async () => {
        const active = document.fullscreenElement;
        if (active) {
          await document.exitFullscreen?.();
          return;
        }
        await (iframe?.requestFullscreen?.() ?? shell?.requestFullscreen?.());
      });
      share?.addEventListener("click", async () => {
        const data = { title: "Amaze Game", text: "Play Amaze Game online.", url: location.href };
        try {
          if (navigator.share) await navigator.share(data);
          else await navigator.clipboard?.writeText(location.href);
        } catch {}
      });
    })();
  </script>
</BaseLayout>
<style>
  /* Occupy only the existing outer margin; game sizing/position is unchanged. */
  .play-ad-rail { display: none; }
  @media (min-width: 1680px) {
    .play-ad-rail { display: block; position: absolute; z-index: 1; width: 160px; left: calc(50% + 664px); top: 22.4px; }
  }
  .play-ad-leaderboard { width: min(1120px, calc(100% - 48px)); margin-inline: auto; }
</style>
